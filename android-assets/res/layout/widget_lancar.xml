<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Lançar gasto" (RemoteViews: só LinearLayout e TextView). Tocar em qualquer parte abre o app na folha de lançar.
     Os valores começam escondidos: até o app mandar a sobra (e sempre com PIN ligado), o widget mostra só o botão.
     Esta é também a prévia mostrada na lista de widgets do Android 12 em diante. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_botao"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:text="@string/widget_lancar_botao"
        android:textColor="#110E18"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_valores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_sobra"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#EEEAF5"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#9C9BF5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
